// The agent loop — control flow around the LLM: conversation state in,
// tool calls and RAG in the middle, spoken reply out.
//
// Re-render:  curl -s --data-binary @agent.dot https://kroki.io/graphviz/svg
// then inline the result into ../about.html

digraph agent {
  rankdir=TB;
  bgcolor="transparent";
  node [shape=box, style="rounded,filled", fillcolor="white", color="#000000",
        fontname="Roboto,Helvetica,Arial,sans-serif", fontsize=11,
        margin="0.20,0.13"];
  edge [color="#000000", arrowsize=0.8,
        fontname="Roboto,Helvetica,Arial,sans-serif", fontsize=9,
        fontcolor="#333333"];

  inputs [label="Turn input\ntranscript  +  conversation history (≤ 20 messages)\n+  system prompt (custom / preset / default)\n+  “a PDF is uploaded” note when one is loaded",
          fillcolor="#eef6ee"];

  subgraph cluster_loop {
    label="agent loop — up to 5 iterations";
    fontname="Roboto,Helvetica,Arial,sans-serif";
    fontsize=10;
    fontcolor="#2e7d32";
    color="#2e7d32";
    style="rounded";
    bgcolor="#f6faf6";

    llm  [label="LLM   (tool_choice = auto)", color="#2e7d32", penwidth=2];
    dec  [label="tool calls?", shape=diamond, fillcolor="#fffbe6",
          color="#8a7c1a"];
    exec [label="execute tool"];
  }

  final [label="final text"];
  out   [label="strip_markdown  →  TTS", fillcolor="#eef6ee"];

  tools [label="7 tools · all free / keyless\nweather · calculator · wikipedia · dictionary\nexchange_rate · world_time · search_document"];

  rag [label="RAG over the uploaded PDF\nPDF ≤ 10 pages / ≤ 20 MB\n→ chunk 1000 chars, 150 overlap\n→ embed  BAAI/bge-small-en-v1.5  (fastembed)\n→ top-4 passages by cosine",
       color="#2e7d32"];

  inputs -> llm;
  llm  -> dec;
  dec  -> exec  [label="  yes"];
  exec -> llm   [label="  tool result appended"];
  dec  -> final [label="  no"];
  final -> out;

  dec   -> tools [label="  picks from", style=dashed, constraint=false];
  tools -> rag   [label="  search_document", style=dashed];
}
