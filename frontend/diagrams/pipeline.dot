// Real-time voice pipeline — one turn, from speech to audio.
// Timings are rough estimates for this stack (Moonshine tiny STT,
// Groq gpt-oss-20b, Piper TTS); the repo persists no measured latency.
//
// Re-render:  curl -s --data-binary @pipeline.dot https://kroki.io/graphviz/svg
// then inline the result into ../about.html

digraph pipeline {
  rankdir=TB;
  bgcolor="transparent";
  node [shape=box, style="rounded,filled", fillcolor="white", color="#000000",
        fontname="Roboto,Helvetica,Arial,sans-serif", fontsize=11,
        margin="0.20,0.13"];
  edge [color="#000000", arrowsize=0.8,
        fontname="Roboto,Helvetica,Arial,sans-serif", fontsize=9,
        fontcolor="#333333"];

  speak [label="Browser — hold Space and speak", fillcolor="#eef6ee"];
  stt   [label="STT · Moonshine streaming tiny (Q8, in-process)\npartial transcripts stream live · finalize on release ≈ 100–250 ms",
         color="#2e7d32", penwidth=2];
  llm   [label="LLM · Groq  openai/gpt-oss-20b\nfirst token ≈ 250–450 ms · short reply ≈ 0.5–1.2 s\n(+ a tool round-trip if a tool is called — see “The agent loop”)",
         color="#2e7d32", penwidth=2];
  strip [label="strip_markdown → [STREAM:] text to the UI"];
  tts   [label="TTS · Piper  en_US-amy-medium (streaming subprocess)\nfirst audio ≈ 150–350 ms, then faster than real time",
         color="#2e7d32", penwidth=2];
  play  [label="Browser · Web Audio — gapless playback · Space = barge-in",
         fillcolor="#eef6ee"];
  done  [label="end-to-end to first audio ≈ 1–2 s   (rough estimate)",
         shape=note, fillcolor="#fffbe6", color="#8a7c1a"];

  speak -> stt  [label="  16 kHz PCM16 over one WebSocket"];
  stt   -> llm  [label="  final transcript"];
  llm   -> strip;
  strip -> tts;
  tts   -> play [label="  Int16 PCM frames"];
  play  -> done [style=dotted, arrowhead=none];
}
