    end
    C -.->|picks from| TOOLS
    TOOLS -.->|search_document| RAG

    classDef input fill:#eef6ee,stroke:#000;
    classDef model fill:#ffffff,stroke:#2e7d32,stroke-width:2px;
    classDef dec fill:#fffbe6,stroke:#8a7c1a;
