flowchart TD
    A["A · Turn input"] --> B["B · LLM"]
    B --> C{"C · Tool calls?"}
    C -->|yes| D["D · Execute tool"]
    D -->|result appended| B
    C -->|no| E["E · Final text"]
    E --> F["F · Speak reply"]

    subgraph LOOP["Agent loop · up to 5 iterations"]
        B
        C
        D
    end
    subgraph TOOLS["G · Tool picker"]
